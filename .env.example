NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=
# 32+ random bytes, stable across deployments; never prefix with NEXT_PUBLIC
UPLOAD_TOKEN_SECRET=
CRON_SECRET=
