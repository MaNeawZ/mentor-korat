# Scheduler is enabled by default. Optional GitHub VARIABLE to pause: WORKER_SCHEDULER_ENABLED=false
# Bootstrap only: existing Supabase Auth user ID; never create a public signup
BOOTSTRAP_USER_ID=
BOOTSTRAP_USER_NAME=
